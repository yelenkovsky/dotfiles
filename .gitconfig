[user]
	name = yelenkovsky
	email = yelenkovsky@xbloc.dev
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIALg80r6qJFk7GyQkMW72SxAKhyP8THtAJwh82ES7DN0
[credential "https://github.com"]
	helper = 
	helper = !/home/xbloc/.local/share/mise/installs/gh/2.100.0/gh_2.100.0_linux_amd64/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/xbloc/.local/share/mise/installs/gh/2.100.0/gh_2.100.0_linux_amd64/bin/gh auth git-credential
[gpg]
	format = ssh
[gpg "ssh"]
	# Public half of the Ed25519 key kept in Proton Pass; signing goes through
	# its SSH agent (SSH_AUTH_SOCK), so the private key never leaves Proton Pass.
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
