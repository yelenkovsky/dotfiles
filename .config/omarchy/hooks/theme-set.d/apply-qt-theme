#!/usr/bin/env bash
# Apply the current Omarchy palette to KF6/Qt (Krusader) and GTK.

set -euo pipefail

THEME_DIR="${HOME}/.local/state/omarchy/current/theme"
TPL_DIR="${HOME}/.config/omarchy/themed"
KDEGLOBALS="${HOME}/.config/kdeglobals"
GTK3_DIR="${HOME}/.config/gtk-3.0"
GTK4_DIR="${HOME}/.config/gtk-4.0"

expand_tpl() {
  local src="$1"
  local dest="$2"

  python3 - "$src" "$dest" <<'PY'
import re
import subprocess
import sys

src, dest = sys.argv[1], sys.argv[2]
pairs = {}
raw = subprocess.check_output(["omarchy-theme-color", "--all"], text=True)
for line in raw.splitlines():
    if "\t" not in line:
        continue
    key, value = line.split("\t", 1)
    pairs[key] = value
    if re.fullmatch(r"#[0-9A-Fa-f]{6}", value):
        r = int(value[1:3], 16)
        g = int(value[3:5], 16)
        b = int(value[5:7], 16)
        pairs[f"{key}_rgb"] = f"{r},{g},{b}"
        pairs[f"{key}_strip"] = value[1:]

text = open(src, encoding="utf-8").read()

def repl(match: re.Match[str]) -> str:
    token = match.group(1).strip()
    return pairs.get(token, match.group(0))

text = re.sub(r"\{\{\s*([A-Za-z0-9_]+)\s*\}\}", repl, text)
with open(dest, "w", encoding="utf-8") as handle:
    handle.write(text)
PY
}

mkdir -p "$(dirname "$KDEGLOBALS")" "$GTK3_DIR" "$GTK4_DIR"

if [[ -f $TPL_DIR/kdeglobals.tpl ]]; then
  expand_tpl "$TPL_DIR/kdeglobals.tpl" "$KDEGLOBALS"
elif [[ -f $THEME_DIR/kdeglobals ]]; then
  install -D -m 644 "$THEME_DIR/kdeglobals" "$KDEGLOBALS"
fi

if [[ -f $THEME_DIR/icons.theme && -f $KDEGLOBALS ]]; then
  icon_theme="$(<"$THEME_DIR/icons.theme")"
  python3 - "$KDEGLOBALS" "$icon_theme" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
theme = sys.argv[2].strip()
text = path.read_text(encoding="utf-8")
if "[Icons]" in text:
    import re
    text = re.sub(r"(?m)^Theme=.*$", f"Theme={theme}", text, count=1)
else:
    text += f"\n[Icons]\nTheme={theme}\n"
path.write_text(text, encoding="utf-8")
PY
fi

if [[ -f $TPL_DIR/gtk.css.tpl ]]; then
  expand_tpl "$TPL_DIR/gtk.css.tpl" "$GTK3_DIR/gtk.css"
  install -D -m 644 "$GTK3_DIR/gtk.css" "$GTK4_DIR/gtk.css"
elif [[ -f $THEME_DIR/gtk.css ]]; then
  install -D -m 644 "$THEME_DIR/gtk.css" "$GTK3_DIR/gtk.css"
  install -D -m 644 "$THEME_DIR/gtk.css" "$GTK4_DIR/gtk.css"
fi

mode="$(omarchy-theme-color mode 2>/dev/null || echo dark)"
if [[ $mode == light ]]; then
  gtk_theme="Adwaita"
  color_scheme="prefer-light"
  prefer_dark=false
else
  gtk_theme="Adwaita-dark"
  color_scheme="prefer-dark"
  prefer_dark=true
fi

icon_theme=""
if [[ -f $THEME_DIR/icons.theme ]]; then
  icon_theme="$(tr -d '[:space:]' <"$THEME_DIR/icons.theme")"
fi
[[ -n $icon_theme ]] || icon_theme="Yaru-blue"

cat >"$GTK3_DIR/settings.ini" <<EOF
[Settings]
gtk-theme-name=${gtk_theme}
gtk-application-prefer-dark-theme=${prefer_dark}
gtk-icon-theme-name=${icon_theme}
EOF

if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" >/dev/null 2>&1 || true
fi
