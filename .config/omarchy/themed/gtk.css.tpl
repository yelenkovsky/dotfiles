/* Omarchy palette for GTK and Qt (QT_QPA_PLATFORMTHEME=gtk3). */

@define-color theme_bg_color {{ background }};
@define-color theme_fg_color {{ bright_foreground }};
@define-color theme_base_color {{ background }};
@define-color theme_text_color {{ bright_foreground }};
@define-color theme_selected_bg_color {{ accent }};
@define-color theme_selected_fg_color {{ darker_background }};
@define-color insensitive_bg_color {{ lighter_background }};
@define-color insensitive_fg_color {{ dark_foreground }};
@define-color insensitive_base_color {{ lighter_background }};
@define-color theme_unfocused_bg_color {{ background }};
@define-color theme_unfocused_fg_color {{ foreground }};
@define-color theme_unfocused_base_color {{ background }};
@define-color theme_unfocused_text_color {{ foreground }};
@define-color theme_unfocused_selected_bg_color {{ selection }};
@define-color theme_unfocused_selected_fg_color {{ bright_foreground }};
@define-color borders {{ muted }};
@define-color unfocused_borders {{ muted }};
@define-color warning_color {{ yellow }};
@define-color error_color {{ red }};
@define-color success_color {{ green }};
@define-color accent_color {{ accent }};
